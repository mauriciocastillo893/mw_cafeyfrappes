# Copiar a .env.local y llenar. Nunca commitear valores reales.
# De dónde sale cada variable: docs/configuracion-y-despliegue.md

# --- Supabase ---
# Local: `pnpm exec supabase start` imprime URL y llaves (puerto 55321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Cron (Vercel manda este bearer token al cron diario) ---
CRON_SECRET=

# --- Fase 5: Google (Calendar + Gmail; un refresh token con ambos scopes) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# OWNER_NOTIFY_EMAIL=

# --- Fase 6: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Fase 7: Instagram ---
# META_APP_SECRET=
# IG_VERIFY_TOKEN=
